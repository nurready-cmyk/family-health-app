// Портировано из core/rules.py. Срабатывают на последних известных значениях
// показателей, опираются на checkNorm_() из Norms.gs (то есть учитывают и
// личные нормы, и справочник).

function statusIs_(values, gender, key, expected) {
  var raw = values[key];
  if (raw == null || raw === '') return false;
  var value = parseFloat(String(raw).replace(',', '.'));
  if (isNaN(value)) return false;
  var result = checkNorm_(key, value, gender);
  return result != null && result.status === expected;
}

function pressureHigh_(values, gender) {
  var s = parseFloat(values.systolic);
  var d = parseFloat(values.diastolic);
  return (!isNaN(s) && s > 130) || (!isNaN(d) && d > 85);
}

